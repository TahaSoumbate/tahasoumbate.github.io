<mjml>
  <mj-head>
    <mj-title>How was your order?</mj-title>
    <mj-preview>Rate your Wireless Headphones.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
    </mj-attributes>
    <mj-breakpoint width="600px" />
  </mj-head>
  <mj-body background-color="#ffe5d0" width="600px">
    <mj-section padding="12px 0"><mj-column></mj-column></mj-section>
    <mj-section padding="28px 40px 20px" background-color="#ffffff" border-radius="12px 12px 0 0">
      <mj-column>
        <mj-text font-size="22px" line-height="28px" color="#ca6510" align="left" font-weight="900" padding="0 0 0px">Kova</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 40px 28px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="30px" line-height="36px" color="#111827" align="center" font-weight="800" padding="0 0 16px">How was your order?</mj-text>
        <mj-text font-size="16px" line-height="25px" color="#4b5563" align="center" font-weight="normal" padding="0 0 0px">You got your Wireless Headphones a few days ago. How would you rate them?</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 34px 28px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="16px" line-height="25px" color="#4b5563" align="left" font-weight="normal" padding="0 0 8px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td width="20%" style="padding:3px"><a href="#" style="font-family:Helvetica,Arial,sans-serif;display:block;padding:12px 0;border:1px solid #ca6510;border-radius:8px;font-size:15px;line-height:20px;font-weight:700;color:#ca6510;text-decoration:none;text-align:center">1</a></td><td width="20%" style="padding:3px"><a href="#" style="font-family:Helvetica,Arial,sans-serif;display:block;padding:12px 0;border:1px solid #ca6510;border-radius:8px;font-size:15px;line-height:20px;font-weight:700;color:#ca6510;text-decoration:none;text-align:center">2</a></td><td width="20%" style="padding:3px"><a href="#" style="font-family:Helvetica,Arial,sans-serif;display:block;padding:12px 0;border:1px solid #ca6510;border-radius:8px;font-size:15px;line-height:20px;font-weight:700;color:#ca6510;text-decoration:none;text-align:center">3</a></td><td width="20%" style="padding:3px"><a href="#" style="font-family:Helvetica,Arial,sans-serif;display:block;padding:12px 0;border:1px solid #ca6510;border-radius:8px;font-size:15px;line-height:20px;font-weight:700;color:#ca6510;text-decoration:none;text-align:center">4</a></td><td width="20%" style="padding:3px"><a href="#" style="font-family:Helvetica,Arial,sans-serif;display:block;padding:12px 0;border:1px solid #ca6510;border-radius:8px;font-size:15px;line-height:20px;font-weight:700;color:#ca6510;text-decoration:none;text-align:center">5</a></td></tr></table></mj-text>
        <mj-text font-size="13px" line-height="20px" color="#6b7280" align="center" font-weight="normal" padding="0 0 0px">1 = poor &nbsp;&middot;&nbsp; 5 = excellent</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 32px" background-color="#ffffff">
      <mj-column>
        <mj-button href="#" background-color="#ca6510" color="#ffffff" border-radius="6px" font-size="16px" font-weight="700" inner-padding="14px 30px" padding="0" align="center">Write a review</mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 8px" background-color="#ffffff" border-radius="0 0 12px 12px">
      <mj-column>
        <mj-spacer height="8px" />
      </mj-column>
    </mj-section>
    <mj-section padding="24px 40px" background-color="transparent">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#9ca3af" align="center" font-weight="normal" padding="0 0 6px">Kova &middot; 123 Market Street, Casablanca, Morocco</mj-text>
        <mj-text font-size="12px" line-height="18px" color="#9ca3af" align="center" font-weight="normal" padding="0 0 0px">You received this email because you signed up at Kova. <a href="#" style="color:#9ca3af;">Unsubscribe</a> &middot; <a href="#" style="color:#9ca3af;">Preferences</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
