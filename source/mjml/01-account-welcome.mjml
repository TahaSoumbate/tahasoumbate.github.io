<mjml>
  <mj-head>
    <mj-title>Welcome to Nova</mj-title>
    <mj-preview>Your account is ready. Here's how to start.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
    </mj-attributes>
    <mj-breakpoint width="600px" />
  </mj-head>
  <mj-body background-color="#e0cffc" width="600px">
    <mj-section padding="12px 0"><mj-column></mj-column></mj-section>
    <mj-section padding="28px 40px 20px" background-color="#ffffff" border-radius="12px 12px 0 0">
      <mj-column>
        <mj-text font-size="22px" line-height="28px" color="#520dc2" align="left" font-weight="900" padding="0 0 0px">Nova</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="44px 40px" background-color="#520dc2">
      <mj-column>
        <mj-text font-size="12px" line-height="19px" color="#520dc2" align="center" font-weight="normal" padding="0 0 16px"><span style="font-family:Helvetica,Arial,sans-serif;display:inline-block;padding:4px 10px;border-radius:999px;background-color:#ffffff;font-size:12px;line-height:16px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#520dc2">Welcome</span></mj-text>
        <mj-text font-size="34px" line-height="41px" color="#ffffff" align="center" font-weight="800" padding="0 0 16px">Welcome to Nova, Sara!</mj-text>
        <mj-text font-size="17px" line-height="26px" color="#e0cffc" align="center" font-weight="normal" padding="0 0 24px">Your account is ready. Build your first project in under 5 minutes.</mj-text>
        <mj-button href="#" background-color="#ffffff" color="#520dc2" border-radius="999px" font-size="16px" font-weight="700" inner-padding="14px 30px" padding="0" align="center">Get started</mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="28px 40px 0" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="19px" line-height="25px" color="#111827" align="left" font-weight="700" padding="0 0 12px">3 steps to get going</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 32px 12px" background-color="#ffffff">
      <mj-column padding="0 8px">
        <mj-text font-size="16px" line-height="25px" color="#4b5563" align="left" font-weight="normal" padding="0 0 12px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" valign="middle" height="100" bgcolor="#520dc2" style="font-family:Helvetica,Arial,sans-serif;height:100px;background-color:#520dc2;border-radius:10px;font-size:22px;font-weight:800;color:#ffffff">1</td></tr></table></mj-text>
        <mj-text font-size="16px" line-height="21px" color="#111827" align="left" font-weight="700" padding="0 0 4px">Create a project</mj-text>
        <mj-text font-size="14px" line-height="22px" color="#4b5563" align="left" font-weight="normal" padding="0 0 16px">Pick a template or start blank.</mj-text>
      </mj-column>
      <mj-column padding="0 8px">
        <mj-text font-size="16px" line-height="25px" color="#4b5563" align="left" font-weight="normal" padding="0 0 12px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" valign="middle" height="100" bgcolor="#1f2937" style="font-family:Helvetica,Arial,sans-serif;height:100px;background-color:#1f2937;border-radius:10px;font-size:22px;font-weight:800;color:#ffffff">2</td></tr></table></mj-text>
        <mj-text font-size="16px" line-height="21px" color="#111827" align="left" font-weight="700" padding="0 0 4px">Invite your team</mj-text>
        <mj-text font-size="14px" line-height="22px" color="#4b5563" align="left" font-weight="normal" padding="0 0 16px">Work together in real time.</mj-text>
      </mj-column>
      <mj-column padding="0 8px">
        <mj-text font-size="16px" line-height="25px" color="#4b5563" align="left" font-weight="normal" padding="0 0 12px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" valign="middle" height="100" bgcolor="#520dc2" style="font-family:Helvetica,Arial,sans-serif;height:100px;background-color:#520dc2;border-radius:10px;font-size:22px;font-weight:800;color:#ffffff">3</td></tr></table></mj-text>
        <mj-text font-size="16px" line-height="21px" color="#111827" align="left" font-weight="700" padding="0 0 4px">Publish</mj-text>
        <mj-text font-size="14px" line-height="22px" color="#4b5563" align="left" font-weight="normal" padding="0 0 16px">Go live with one click.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 28px" background-color="#ffffff">
      <mj-column background-color="#e0cffc" border-radius="8px" padding="16px 18px" border-left="4px solid #520dc2">
        <mj-text font-size="15px" line-height="23px" color="#374151" align="left" font-weight="normal" padding="0 0 0px">Questions? Just reply to this email. A real person will answer.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 8px" background-color="#ffffff" border-radius="0 0 12px 12px">
      <mj-column>
        <mj-spacer height="8px" />
      </mj-column>
    </mj-section>
    <mj-section padding="24px 40px" background-color="transparent">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#9ca3af" align="center" font-weight="normal" padding="0 0 6px">Nova &middot; 123 Market Street, Casablanca, Morocco</mj-text>
        <mj-text font-size="12px" line-height="18px" color="#9ca3af" align="center" font-weight="normal" padding="0 0 0px">You received this email because you signed up at Nova. <a href="#" style="color:#9ca3af;">Unsubscribe</a> &middot; <a href="#" style="color:#9ca3af;">Preferences</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
