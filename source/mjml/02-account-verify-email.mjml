<mjml>
  <mj-head>
    <mj-title>Verify your email</mj-title>
    <mj-preview>One click to confirm your email address.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
    </mj-attributes>
    <mj-breakpoint width="600px" />
  </mj-head>
  <mj-body background-color="#cfe2ff" width="600px">
    <mj-section padding="12px 0"><mj-column></mj-column></mj-section>
    <mj-section padding="28px 40px 20px" background-color="#ffffff" border-radius="12px 12px 0 0">
      <mj-column>
        <mj-text font-size="22px" line-height="28px" color="#0a58ca" align="left" font-weight="900" padding="0 0 0px">Cloudly</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="4px 40px 24px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="16px" line-height="25px" color="#4b5563" align="left" font-weight="normal" padding="0 0 0px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" valign="middle" height="110" bgcolor="#cfe2ff" style="font-family:Helvetica,Arial,sans-serif;height:110px;background-color:#cfe2ff;border-radius:10px;font-size:44px;font-weight:800;color:#0a58ca">&#9993;</td></tr></table></mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 40px 28px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="30px" line-height="36px" color="#111827" align="center" font-weight="800" padding="0 0 16px">Confirm your email</mj-text>
        <mj-text font-size="16px" line-height="25px" color="#4b5563" align="center" font-weight="normal" padding="0 0 24px">Thanks for signing up! Please confirm this is your email address so we can keep your account safe.</mj-text>
        <mj-button href="#" background-color="#0a58ca" color="#ffffff" border-radius="6px" font-size="16px" font-weight="700" inner-padding="14px 30px" padding="0" align="center">Verify email</mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 24px" background-color="#ffffff">
      <mj-column>
        <mj-divider border-color="#e5e7eb" border-width="1px" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 28px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="14px" line-height="22px" color="#6b7280" align="left" font-weight="normal" padding="0 0 0px">Didn't create a Cloudly account? You can safely ignore this email.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 8px" background-color="#ffffff" border-radius="0 0 12px 12px">
      <mj-column>
        <mj-spacer height="8px" />
      </mj-column>
    </mj-section>
    <mj-section padding="24px 40px" background-color="transparent">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#9ca3af" align="center" font-weight="normal" padding="0 0 6px">Cloudly &middot; 123 Market Street, Casablanca, Morocco</mj-text>
        <mj-text font-size="12px" line-height="18px" color="#9ca3af" align="center" font-weight="normal" padding="0 0 0px">You received this email because you signed up at Cloudly. <a href="#" style="color:#9ca3af;">Unsubscribe</a> &middot; <a href="#" style="color:#9ca3af;">Preferences</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
