<mjml>
  <mj-head>
    <mj-title>Vote: what should we cover next?</mj-title>
    <mj-preview>Pick the topic for our next workshop.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
    </mj-attributes>
    <mj-breakpoint width="600px" />
  </mj-head>
  <mj-body background-color="#e2d9f3" width="600px">
    <mj-section padding="12px 0"><mj-column></mj-column></mj-section>
    <mj-section padding="28px 40px 20px" background-color="#ffffff" border-radius="12px 12px 0 0">
      <mj-column>
        <mj-text font-size="22px" line-height="28px" color="#59359a" align="left" font-weight="900" padding="0 0 0px">DevHub</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 40px 28px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="12px" line-height="19px" color="#59359a" align="left" font-weight="normal" padding="0 0 14px"><span style="font-family:Helvetica,Arial,sans-serif;display:inline-block;padding:4px 10px;border-radius:999px;background-color:#e2d9f3;font-size:12px;line-height:16px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#59359a">Poll</span></mj-text>
        <mj-text font-size="30px" line-height="36px" color="#111827" align="left" font-weight="800" padding="0 0 16px">Quick poll: what's next?</mj-text>
        <mj-text font-size="16px" line-height="25px" color="#4b5563" align="left" font-weight="normal" padding="0 0 0px">Pick the topic for our next live workshop. Voting closes Friday.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 34px 28px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="16px" line-height="25px" color="#4b5563" align="left" font-weight="normal" padding="0 0 0px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td width="25%" style="padding:3px"><a href="#" style="font-family:Helvetica,Arial,sans-serif;display:block;padding:12px 0;border:1px solid #59359a;border-radius:8px;font-size:15px;line-height:20px;font-weight:700;color:#59359a;text-decoration:none;text-align:center">React</a></td><td width="25%" style="padding:3px"><a href="#" style="font-family:Helvetica,Arial,sans-serif;display:block;padding:12px 0;border:1px solid #59359a;border-radius:8px;font-size:15px;line-height:20px;font-weight:700;color:#59359a;text-decoration:none;text-align:center">Vue</a></td><td width="25%" style="padding:3px"><a href="#" style="font-family:Helvetica,Arial,sans-serif;display:block;padding:12px 0;border:1px solid #59359a;border-radius:8px;font-size:15px;line-height:20px;font-weight:700;color:#59359a;text-decoration:none;text-align:center">Svelte</a></td><td width="25%" style="padding:3px"><a href="#" style="font-family:Helvetica,Arial,sans-serif;display:block;padding:12px 0;border:1px solid #59359a;border-radius:8px;font-size:15px;line-height:20px;font-weight:700;color:#59359a;text-decoration:none;text-align:center">Angular</a></td></tr></table></mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 28px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="14px" line-height="22px" color="#6b7280" align="left" font-weight="normal" padding="0 0 0px">Results will be shared in next month's newsletter.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 8px" background-color="#ffffff" border-radius="0 0 12px 12px">
      <mj-column>
        <mj-spacer height="8px" />
      </mj-column>
    </mj-section>
    <mj-section padding="24px 40px" background-color="transparent">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#9ca3af" align="center" font-weight="normal" padding="0 0 6px">DevHub &middot; 123 Market Street, Casablanca, Morocco</mj-text>
        <mj-text font-size="12px" line-height="18px" color="#9ca3af" align="center" font-weight="normal" padding="0 0 0px">You received this email because you signed up at DevHub. <a href="#" style="color:#9ca3af;">Unsubscribe</a> &middot; <a href="#" style="color:#9ca3af;">Preferences</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
