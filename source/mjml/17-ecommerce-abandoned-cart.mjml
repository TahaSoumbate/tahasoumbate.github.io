<mjml>
  <mj-head>
    <mj-title>You left something in your cart</mj-title>
    <mj-preview>Your cart is saved. Here's 10% off.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
    </mj-attributes>
    <mj-breakpoint width="600px" />
  </mj-head>
  <mj-body background-color="#ffe5d0" width="600px">
    <mj-section padding="12px 0"><mj-column></mj-column></mj-section>
    <mj-section padding="28px 40px 20px" background-color="#ffffff" border-radius="12px 12px 0 0">
      <mj-column>
        <mj-text font-size="22px" line-height="28px" color="#ca6510" align="left" font-weight="900" padding="0 0 0px">Bloom</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 40px 28px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="30px" line-height="36px" color="#111827" align="center" font-weight="800" padding="0 0 16px">Forgot something?</mj-text>
        <mj-text font-size="16px" line-height="25px" color="#4b5563" align="center" font-weight="normal" padding="0 0 0px">Your cart is still waiting. Items sell out fast, so we saved them for you.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 40px 28px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="17px" line-height="22px" color="#111827" align="left" font-weight="700" padding="0 0 4px">Your cart</mj-text>
        <mj-table font-size="15px" color="#374151" padding="0"><tr><td style="padding:10px 0;border-bottom:1px solid #e5e7eb;">Rose Candle (Large)</td><td align="right" style="padding:10px 0;border-bottom:1px solid #e5e7eb;">$24.00</td></tr><tr><td style="padding:10px 0;border-bottom:1px solid #e5e7eb;">Lavender Soap &times; 2</td><td align="right" style="padding:10px 0;border-bottom:1px solid #e5e7eb;">$12.00</td></tr><tr><td style="padding:14px 0 0;font-weight:800;color:#111827;font-size:16px;">Total</td><td align="right" style="padding:14px 0 0;font-weight:800;color:#111827;font-size:16px;">$36.00</td></tr></mj-table>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 28px" background-color="#ffffff">
      <mj-column background-color="#ffe5d0" border-radius="8px" padding="16px 18px" border-left="4px solid #ca6510">
        <mj-text font-size="15px" line-height="23px" color="#374151" align="left" font-weight="normal" padding="0 0 0px">Finish your order in 24 hours and get <b>10% off</b> with code <b>COMEBACK10</b>.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 32px" background-color="#ffffff">
      <mj-column>
        <mj-button href="#" background-color="#ca6510" color="#ffffff" border-radius="6px" font-size="16px" font-weight="700" inner-padding="14px 30px" padding="0" align="center">Return to my cart</mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 8px" background-color="#ffffff" border-radius="0 0 12px 12px">
      <mj-column>
        <mj-spacer height="8px" />
      </mj-column>
    </mj-section>
    <mj-section padding="24px 40px" background-color="transparent">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#9ca3af" align="center" font-weight="normal" padding="0 0 6px">Bloom &middot; 123 Market Street, Casablanca, Morocco</mj-text>
        <mj-text font-size="12px" line-height="18px" color="#9ca3af" align="center" font-weight="normal" padding="0 0 0px">You received this email because you signed up at Bloom. <a href="#" style="color:#9ca3af;">Unsubscribe</a> &middot; <a href="#" style="color:#9ca3af;">Preferences</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
