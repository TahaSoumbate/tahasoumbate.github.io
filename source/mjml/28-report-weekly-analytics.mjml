<mjml>
  <mj-head>
    <mj-title>Your weekly report</mj-title>
    <mj-preview>Visitors up 12% this week.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
    </mj-attributes>
    <mj-breakpoint width="600px" />
  </mj-head>
  <mj-body background-color="#e0cffc" width="600px">
    <mj-section padding="12px 0"><mj-column></mj-column></mj-section>
    <mj-section padding="28px 40px 20px" background-color="#ffffff" border-radius="12px 12px 0 0">
      <mj-column>
        <mj-text font-size="22px" line-height="28px" color="#520dc2" align="left" font-weight="900" padding="0 0 0px">Metricly</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 40px 28px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="12px" line-height="19px" color="#520dc2" align="left" font-weight="normal" padding="0 0 14px"><span style="font-family:Helvetica,Arial,sans-serif;display:inline-block;padding:4px 10px;border-radius:999px;background-color:#e0cffc;font-size:12px;line-height:16px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#520dc2">Weekly report</span></mj-text>
        <mj-text font-size="30px" line-height="36px" color="#111827" align="left" font-weight="800" padding="0 0 16px">Your week in numbers</mj-text>
        <mj-text font-size="16px" line-height="25px" color="#4b5563" align="left" font-weight="normal" padding="0 0 0px">11-17 November 2026 &middot; acme.com</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="4px 34px 28px" background-color="#ffffff">
      <mj-column vertical-align="top" padding="0 6px 12px" inner-background-color="#e0cffc" inner-border-radius="10px">
        <mj-spacer height="18px" />
        <mj-text font-size="26px" line-height="40px" color="#520dc2" align="center" font-weight="normal" padding="0 0 2px"><b>8,240</b></mj-text>
        <mj-text font-size="13px" line-height="20px" color="#6b7280" align="center" font-weight="normal" padding="0 0 0px">Visitors</mj-text>
        <mj-text font-size="13px" line-height="20px" color="#146c43" align="center" font-weight="normal" padding="0 0 0px"><b>+12%</b></mj-text>
        <mj-spacer height="18px" />
      </mj-column>
      <mj-column vertical-align="top" padding="0 6px 12px" inner-background-color="#e0cffc" inner-border-radius="10px">
        <mj-spacer height="18px" />
        <mj-text font-size="26px" line-height="40px" color="#520dc2" align="center" font-weight="normal" padding="0 0 2px"><b>312</b></mj-text>
        <mj-text font-size="13px" line-height="20px" color="#6b7280" align="center" font-weight="normal" padding="0 0 0px">Sign-ups</mj-text>
        <mj-text font-size="13px" line-height="20px" color="#146c43" align="center" font-weight="normal" padding="0 0 0px"><b>+8%</b></mj-text>
        <mj-spacer height="18px" />
      </mj-column>
      <mj-column vertical-align="top" padding="0 6px 12px" inner-background-color="#e0cffc" inner-border-radius="10px">
        <mj-spacer height="18px" />
        <mj-text font-size="26px" line-height="40px" color="#520dc2" align="center" font-weight="normal" padding="0 0 2px"><b>3.8%</b></mj-text>
        <mj-text font-size="13px" line-height="20px" color="#6b7280" align="center" font-weight="normal" padding="0 0 0px">Conversion</mj-text>
        <mj-text font-size="13px" line-height="20px" color="#146c43" align="center" font-weight="normal" padding="0 0 0px"><b>+0.4%</b></mj-text>
        <mj-spacer height="18px" />
      </mj-column>
    </mj-section>
    <mj-section padding="8px 40px 28px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="17px" line-height="22px" color="#111827" align="left" font-weight="700" padding="0 0 4px">Top pages</mj-text>
        <mj-table font-size="15px" color="#374151" padding="0"><tr><td style="padding:10px 0;border-bottom:1px solid #e5e7eb;">/pricing</td><td align="right" style="padding:10px 0;border-bottom:1px solid #e5e7eb;">2,104 views</td></tr><tr><td style="padding:10px 0;border-bottom:1px solid #e5e7eb;">/blog/email-tips</td><td align="right" style="padding:10px 0;border-bottom:1px solid #e5e7eb;">1,388 views</td></tr><tr><td style="padding:10px 0;border-bottom:1px solid #e5e7eb;">/features</td><td align="right" style="padding:10px 0;border-bottom:1px solid #e5e7eb;">966 views</td></tr></mj-table>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 32px" background-color="#ffffff">
      <mj-column>
        <mj-button href="#" background-color="#520dc2" color="#ffffff" border-radius="6px" font-size="16px" font-weight="700" inner-padding="14px 30px" padding="0" align="left">Open full report</mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="0 40px 8px" background-color="#ffffff" border-radius="0 0 12px 12px">
      <mj-column>
        <mj-spacer height="8px" />
      </mj-column>
    </mj-section>
    <mj-section padding="24px 40px" background-color="transparent">
      <mj-column>
        <mj-text font-size="12px" line-height="18px" color="#9ca3af" align="center" font-weight="normal" padding="0 0 6px">Metricly &middot; 123 Market Street, Casablanca, Morocco</mj-text>
        <mj-text font-size="12px" line-height="18px" color="#9ca3af" align="center" font-weight="normal" padding="0 0 0px">You received this email because you signed up at Metricly. <a href="#" style="color:#9ca3af;">Unsubscribe</a> &middot; <a href="#" style="color:#9ca3af;">Preferences</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
